# Supabase PostgreSQL (required)
# Dashboard: Project Settings -> Database -> Connection string -> URI (Session pooler, port 6543)
POSTGRES_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Or use DATABASE_URL instead of POSTGRES_URL
# DATABASE_URL=

GEMINI_API_KEY=your-gemini-api-key
JWT_SECRET_KEY=your-jwt-secret
